{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/ar", "destination": "/index.html" },
    { "source": "/en", "destination": "/index.html" },
    { "source": "/work", "destination": "/index.html" },
    { "source": "/work/:project", "destination": "/index.html" },
    { "source": "/ar/work", "destination": "/index.html" },
    { "source": "/en/work", "destination": "/index.html" },
    { "source": "/ar/work/:project", "destination": "/index.html" },
    { "source": "/en/work/:project", "destination": "/index.html" }
  ]
}
